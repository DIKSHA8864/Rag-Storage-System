APP_NAME=Secure RAG Storage System
ENVIRONMENT=development

ORIGINAL_STORAGE_PATH=storage/originals
PROCESSED_STORAGE_PATH=storage/processed
METADATA_STORAGE_PATH=storage/metadata
QUARANTINE_STORAGE_PATH=storage/quarantine
SEGMENTS_STORAGE_PATH=storage/segments
CHUNKS_STORAGE_PATH=storage/chunks
EMBEDDINGS_STORAGE_PATH=storage/embeddings

VECTOR_DB_PATH=vector_db/chroma
DATABASE_PATH=database/metadata.db

# METADATA_BACKEND=postgres (default) or sqlite (fast, zero-setup, used
# by the test suite). Postgres connection details below match
# docker-compose.yml - run `docker compose up -d` before starting the
# app if METADATA_BACKEND=postgres.
METADATA_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_storage
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword

# EMBEDDING_PROVIDER=sentence_transformers is the only one implemented
# today (free, local, no API key) - see app/embeddings/base.py.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Redis - message broker for the background processing queue. Matches
# docker-compose.yml. Point this at Upstash (or another hosted Redis)
# instead if you don't want to run one yourself.
REDIS_URL=redis://localhost:6379/0
PROCESSING_QUEUE_NAME=processing

ALLOWED_EXTENSIONS=.pdf,.docx,.txt
MAX_FILE_SIZE_MB=100

# Change this before exposing the API beyond your own machine.
ADMIN_API_KEY=dev-admin-key-change-me

# Separate key for the End User query/compare API (app/api/end_user_api.py,
# X-End-User-Key header) - grants no access to the Owner/Admin API above.
# Change this too before exposing the API beyond your own machine.
END_USER_API_KEY=dev-enduser-key-change-me

# End User document comparison scoring (app/analysis/) - see
# config/settings.py for what each of these controls and how they
# were calibrated (re-tune if you switch EMBEDDING_MODEL).
MATCH_SCORE_THRESHOLD_MATCH=0.5
MATCH_SCORE_THRESHOLD_PARTIAL=0.3
MATCH_SCORE_COVERAGE_WEIGHT=0.6
MATCH_SCORE_CONFIDENCE_WEIGHT=0.4

# NARRATIVE_PROVIDER=template (default) needs nothing further - free,
# deterministic, no API key. Set to "claude" + ANTHROPIC_API_KEY to have
# the comparison report's prose (not its match score) written by Claude
# instead - see app/analysis/base.py.
NARRATIVE_PROVIDER=template
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5

AUDIT_LOG_PATH=logs/audit.log
# Owner/Admin JWT signing key - REQUIRED, no default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------
# Phase 3/5 - Multimodal intake (app/multimodal/) - Voice/Video - see
# config/settings.py. "mock" needs nothing; real options:
#   OCR_PROVIDER=tesseract  - needs the `tesseract-ocr` system package
#   STT_PROVIDER=whisper    - needs no key, downloads a model on first use
#   VISION_PROVIDER=claude  - needs ANTHROPIC_API_KEY above
# ------------------------------------------------------------------
OCR_PROVIDER=mock
STT_PROVIDER=mock
VISION_PROVIDER=mock
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VIDEO_FRAME_SAMPLE_COUNT=3

INTAKE_STORAGE_PATH=storage/intake
INTAKE_QUARANTINE_STORAGE_PATH=storage/intake_quarantine
INTAKE_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.png,.jpg,.jpeg,.tiff,.bmp,.mp3,.wav,.m4a,.weba,.ogg,.mp4,.mov,.avi,.webm,.zip
INTAKE_MAX_FILE_SIZE_MB=200
INTAKE_ZIP_MAX_FILES=50
INTAKE_ZIP_MAX_TOTAL_SIZE_MB=500
# ------------------------------------------------------------------
# End-user accounts - the admin invites emails on the Users page; each
# person signs up once (a 6-digit code is emailed to confirm the inbox)
# and then signs in with their own password. See
# app/security/end_user_accounts.py.
# ------------------------------------------------------------------
# Where the "create your account" link in invite emails points.
FRONTEND_BASE_URL=http://localhost:3000
END_USER_TOKEN_EXPIRE_MINUTES=480
VERIFICATION_CODE_EXPIRE_MINUTES=10

# EMAIL_PROVIDER=console prints codes/invites in the API terminal (local
# testing only - refused when ENVIRONMENT=production).
# EMAIL_PROVIDER=smtp sends real email. To send from a Gmail account:
#   1. Turn on 2-Step Verification for that Google account.
#   2. Google Account -> Security -> App passwords -> create one.
#   3. Put that 16-character app password below (NOT the Gmail password).
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (default). 465 = TLS from the start - use it if 587 is blocked.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Vault sync - keep the library in step with a Dropbox / Google Drive folder
# (app/vault_sync/, DOCS/RUNBOOK.md "Vault sync"). Leave both options empty
# to keep it off. Run the scheduler with: python scripts/vault_sync.py --watch
# Option A: a folder the Dropbox / Google Drive desktop app syncs on this server.
VAULT_SYNC_DIR=
# Option B: the Dropbox API (create a Dropbox app with files.metadata.read +
# files.content.read, then generate a refresh token for the firm's account).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=
VAULT_SYNC_TENANT_ID=1
VAULT_SYNC_INTERVAL_SECONDS=300
