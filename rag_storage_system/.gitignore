node_modules/
venv/
.venv/
env/
__pycache__/
dist/
build/
.next/
out/
target/
.env
*.log
.DS_Store

# Rebuilt from storage/originals on every processing run (app/jobs/processing.py
# clears them first) - build output, not source.
storage/processed/
storage/segments/
storage/chunks/
storage/embeddings/

# Local copy of the Dropbox library (app/vault_sync/dropbox_source.py) - library content, never source.
storage/vault_mirror/
storage/vault_mirror_connected/

# Redis snapshot files from a local redis-server - job data, never source.
*.rdb

# Library documents, client uploads, quarantined files, databases and logs:
# data, never source. (Files committed before these rules stay tracked in the
# old repository; a copy made with `git archive` leaves them out - see
# /.gitattributes.)
storage/originals/**
!storage/originals/.gitkeep
storage/quarantine/**
!storage/quarantine/.gitkeep
storage/intake/
storage/intake_quarantine/
storage/metadata/*
!storage/metadata/.gitkeep
database/*.db
logs/*
!logs/.gitkeep
